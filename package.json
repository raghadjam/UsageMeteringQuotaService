{
  "name": "usage-metering-quota-service",
  "version": "0.1.0",
  "private": true,
  "description": "Usage metering and quota service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "db:migrate": "tsx --env-file=.env src/db/runMigrations.ts",
    "test": "tsx --test tests/api/auth.test.ts tests/consume/rules.test.ts tests/db/migrations.test.ts",
    "test:db": "tsx --test tests/db/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
